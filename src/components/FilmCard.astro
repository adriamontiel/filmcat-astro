---
// FilmCard.astro — film card linking to /films/[slug]
// data-film kept for JS modal fallback; data-version for filter bar
import type { Film } from '../lib/types';
import { TMDB_185, TMDB_342, TMDB_IMG } from '../lib/tmdb';
import { slugify } from '../lib/slug';
import { cityToProvince } from '../lib/provinces';
import { ratingInfo } from '../lib/rating';

interface Props {
  film: Film;
  priorityCinema?: string;
}
const { film, priorityCinema } = Astro.props;

const sessionCount = film.sessions.reduce((a, s) => a + s.times.length, 0);
const isUpcoming = film.sessions.length === 0;
const filmSlug = slugify(film.title);
const href = priorityCinema
  ? `/films/${filmSlug}?cinema=${encodeURIComponent(priorityCinema)}`
  : `/films/${filmSlug}`;

// Poster URL + responsive srcset (server-side resolved)
// TMDB serves the same image at w185 / w342 / w500 — browser picks the
// best fit for the device DPR and layout width (215 px on desktop).
const posterSrc = film.posterPath ? `${TMDB_IMG}${film.posterPath}` : null;
const posterSrcset = film.posterPath
  ? `${TMDB_185}${film.posterPath} 185w, ${TMDB_342}${film.posterPath} 342w, ${TMDB_IMG}${film.posterPath} 500w`
  : null;

// Abbreviation for placeholder
const abbr = film.title
  .split(' ')
  .filter((w) => w.length > 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase()
  .slice(0, 3);

const isVO = ['VO', 'VOSC', 'VOSE'].includes(film.version);
const ri = ratingInfo(film.rating);

// Compact premiere for upcoming films: "06/03/2026" → "6 de mar."
function premiereCompact(raw: string | undefined): string | null {
  if (!raw || raw === '--') return null;
  const parts = raw.split('/');
  if (parts.length !== 3) return null;
  const [d, m, y] = parts.map(Number);
  if (!d || !m || !y) return null;
  try {
    return new Intl.DateTimeFormat('ca', { day: 'numeric', month: 'short' }).format(
      new Date(y, m - 1, d)
    );
  } catch {
    return null;
  }
}
const premiereLabel = isUpcoming ? premiereCompact(film.premiere) : null;

const VERSION_LABELS: Record<string, string> = {
  VDC: 'Versió Doblada al Català',
  VD: 'Versió Doblada al Català', // legacy alias
  VO: 'Versió Original',
  VOSC: 'Versió Original Subtitulada en Català',
  VOSE: 'Versió Original Subtitulada en Espanyol',
};
const genreFirst = film.genre ? film.genre.split(' · ')[0] : '';
const genreFirstCap = genreFirst ? genreFirst.charAt(0).toUpperCase() + genreFirst.slice(1) : '';

// Space-separated list of provinces where this film is showing (for province filter)
const filmProvinces =
  film.sessions.length > 0
    ? [...new Set(film.sessions.map((s) => cityToProvince(s.city)))].join(' ')
    : 'Barcelona';

// Validate colors — only hex values allowed
const colorRe = /^#[0-9a-fA-F]{3,6}$/;
const c1 = colorRe.test(film.color1) ? film.color1 : '#111';
const c2 = colorRe.test(film.color2) ? film.color2 : '#222';

// Serialize film data for JS modal (quick-view fallback when JS intercepts click)
const filmJson = JSON.stringify({
  id: film.id,
  title: film.title,
  titleOriginal: film.titleOriginal,
  director: film.director,
  synopsis: film.synopsis,
  version: film.version,
  year: film.year,
  genre: film.genre,
  duration: film.duration,
  color1: film.color1,
  color2: film.color2,
  posterPath: film.posterPath,
  backdropPath: film.backdropPath,
  _tmdbId: film._tmdbId ?? null,
  _trailerKey: film._trailerKey ?? null,
  sessions: film.sessions.map((s) => ({ ...s, province: cityToProvince(s.city) })),
});
---

<a
  class="card"
  href={href}
  role="listitem"
  data-version={film.version}
  data-province={filmProvinces}
  data-film={filmJson}
  aria-label={`${film.title} (${film.year}), versió ${film.version}${ri ? `, ${ri.full}` : ''}${!isUpcoming ? `, ${sessionCount} ${sessionCount === 1 ? 'sessió' : 'sessions'}` : `${premiereLabel ? `, estrena ${premiereLabel}` : ', pròximament'}`}`}
>
  <div class="card-img-wrap">
    {
      posterSrc ? (
        <img
          src={posterSrc}
          srcset={posterSrcset ?? undefined}
          sizes="(max-width: 480px) 160px, 215px"
          alt={`Pòster oficial de ${film.title}`}
          loading="lazy"
          decoding="async"
          width="215"
          height="322"
        />
      ) : (
        <div
          class="poster-placeholder"
          style={`background:linear-gradient(160deg,${c1} 0%,${c2} 100%)`}
          aria-hidden="true"
        >
          <svg viewBox="0 0 100 88" width="38" style="opacity:.25">
            <polygon points="50,0 100,88 0,88" fill="white" />
          </svg>
          <div class="abbr">{abbr}</div>
          <div class="pp-title">{film.title}</div>
        </div>
      )
    }
    <div class="card-overlay" aria-hidden="true">
      <div class="card-overlay-title">{film.title}</div>
      <div class="card-overlay-sessions">
        {
          !isUpcoming
            ? `${sessionCount} ${sessionCount === 1 ? 'sessió' : 'sessions'}`
            : 'Pròximament'
        }
      </div>
    </div>
  </div>

  <div class="card-info">
    <div class="card-title">{film.title}</div>
    <div class="card-meta">
      {
        isUpcoming && premiereLabel && (
          <span class="tag tag-premiere" aria-label={`Estrena: ${film.premiere}`}>
            {premiereLabel}
          </span>
        )
      }
      <span class={`badge${isVO ? ' vo' : ''}`}>
        <abbr title={VERSION_LABELS[film.version] ?? film.version}>{film.version}</abbr>
      </span>
      {
        ri && (
          <span class={`badge rating${ri.level !== 'low' ? ` ${ri.level}` : ''}`}>
            <abbr title={ri.full}>{ri.short}</abbr>
          </span>
        )
      }
      <span>{genreFirstCap}</span>
    </div>
  </div>
</a>
