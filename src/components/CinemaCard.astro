---
// CinemaCard.astro — cinema listing card with poster strip
import type { Cinema } from '../lib/types';
import { cinemaSlug } from '../lib/slug';

interface Props {
  cinema: Cinema;
  province?: string;
  topPosters?: string[]; // up to 3 TMDB poster URLs (w185), pre-resolved by index.astro
}

const { cinema, province, topPosters = [] } = Astro.props;
const filmCount = cinema.films ?? 0;
const slug = cinemaSlug(cinema.name);
const extraCount = filmCount > 3 ? filmCount - 3 : 0;
---

<a
  href={`/cinemes/${slug}`}
  class="cinema-card"
  aria-label={`${cinema.name}, ${cinema.city}, ${filmCount} ${filmCount === 1 ? 'pel·lícula' : 'pel·lícules'} en català`}
  data-cinema-province={province}
>
  <!-- ── POSTER STRIP ── -->
  <div class="cinema-card-posters" aria-hidden="true">
    {
      topPosters.length > 0 ? (
        topPosters.map((url) => (
          <div class="cinema-card-poster">
            <img src={url} alt="" loading="lazy" decoding="async" />
          </div>
        ))
      ) : (
        <div class="cinema-card-poster-placeholder">
          <svg viewBox="0 0 100 88" width="24" aria-hidden="true">
            <polygon points="50,0 100,88 0,88" fill="white" opacity="0.12" />
          </svg>
        </div>
      )
    }
    {extraCount > 0 && <div class="cinema-card-poster-extra">+{extraCount}</div>}
  </div>

  <!-- ── INFO ── -->
  <div class="cinema-card-body">
    <span class="session-cinema-name">{cinema.name}</span>
    <div class="cinema-card-meta">
      <div class="session-cinema-city">
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {cinema.city}
      </div>
      <div
        class="cinema-films-count"
        aria-label={`${filmCount} ${filmCount === 1 ? 'pel·lícula' : 'pel·lícules'}`}
      >
        {filmCount}
        {filmCount === 1 ? 'pel·lícula' : 'pel·lícules'}
      </div>
    </div>
  </div>
</a>
