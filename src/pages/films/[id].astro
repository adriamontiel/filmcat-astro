---
// films/[id].astro — individual film detail page
// URL: /films/balandrau-vent-salvatge
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { fetchFilms } from '../../lib/filmcat';
import { fetchTMDBPoster, fetchTMDBDetails } from '../../lib/tmdb';
import { slugify, cinemaSlug } from '../../lib/slug';
import { CINEMA_URLS as _CINEMA_URLS } from '../../lib/cinema-urls';
import { cityToProvince } from '../../lib/provinces';
import { ratingInfo } from '../../lib/rating';

const { id } = Astro.params; // slug from URL

// Fetch all films and find the matching one
const { films, comingSoon } = await fetchFilms();
const allFilms = [...films, ...comingSoon];
const film = allFilms.find((f) => slugify(f.title) === id);

// 404 if not found
if (!film) {
  return Astro.redirect('/', 302);
}

// Fetch TMDB data for this specific film
const tmdb = await fetchTMDBPoster(film.searchTitle, film.year, film.titleOriginal);
if (tmdb) {
  film.posterPath = tmdb.posterPath;
  film.backdropPath = tmdb.backdropPath;
  film._tmdbId = tmdb.tmdbId;

  // Fetch runtime + genres (single extra call; cached with 8h TTL)
  const details = await fetchTMDBDetails(tmdb.tmdbId);
  if (details) {
    if (details.runtime) film.runtime = details.runtime;
    if (details.genres.length) film.genres = details.genres;
  }
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://filmcat.cat';
const filmSlug = slugify(film.title);
const canonicalUrl = `${siteUrl}/films/${filmSlug}`;
const posterUrl = film.posterPath ? `https://image.tmdb.org/t/p/w500${film.posterPath}` : null;
const backdropUrl = film.backdropPath
  ? `https://image.tmdb.org/t/p/w780${film.backdropPath}`
  : null;

const description = film.synopsis
  ? film.synopsis.slice(0, 160).replace(/\s+\S*$/, '') + '…'
  : `${film.title} — Cinema en Català. Horaris i sessions a Catalunya.`;

const isVO = ['VO', 'VOSC', 'VOSE'].includes(film.version);
const ri = ratingInfo(film.rating);

// Clean first language: "català (60 %); castellà" → "català"
const cleanLanguage = film.language
  ? film.language
      .split(';')[0]
      .replace(/\s*\(\d+\s*%\)/, '')
      .trim()
  : '';

// Format premiere date to Catalan: "06/03/2026" → "6 de març de 2026"
function formatPremiere(raw: string | undefined): string | null {
  if (!raw || raw === '--') return null;
  const parts = raw.split('/');
  if (parts.length !== 3) return null;
  const [d, m, y] = parts.map(Number);
  if (!d || !m || !y) return null;
  try {
    return new Intl.DateTimeFormat('ca', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(y, m - 1, d));
  } catch {
    return raw;
  }
}
const premiereDisplay = formatPremiere(film.premiere);

const versionLabel: Record<string, string> = {
  VDC: 'Versió Doblada al Català',
  VD: 'Versió Doblada al Català', // legacy alias
  VO: 'Versió Original',
  VOSC: 'Versió Original Subtitulada en Català',
  VOSE: 'Versió Original Subtitulada en Espanyol',
};

// Session count for this film (used in the sessions heading)
const sessionCount = film.sessions.reduce((a, s) => a + s.times.length, 0);

// Global stats for the footer (same as home page)
const totalFilmCount = films.length;
const totalCinemaCount = new Set(films.flatMap((f) => f.sessions.map((s) => s.cinema))).size;
const totalSessionCount = films.reduce(
  (a, f) => a + f.sessions.reduce((b, s) => b + s.times.length, 0),
  0
);

// JSON-LD Movie schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Movie',
  name: film.title,
  ...(film.titleOriginal && film.titleOriginal !== film.title
    ? { alternateName: film.titleOriginal }
    : {}),
  description: film.synopsis || '',
  datePublished: String(film.year),
  ...(film.director ? { director: { '@type': 'Person', name: film.director } } : {}),
  ...(posterUrl ? { image: posterUrl } : {}),
  ...(film.runtime ? { duration: `PT${film.runtime}M` } : {}),
  ...(film.genres?.length ? { genre: film.genres } : {}),
  ...(film.rating && film.rating !== '--' ? { contentRating: film.rating } : {}),
  url: canonicalUrl,
  inLanguage: 'ca',
  offers:
    film.sessions.length > 0
      ? {
          '@type': 'Offer',
          availability: 'https://schema.org/InStock',
          priceCurrency: 'EUR',
        }
      : undefined,
  ...(film._trailerKey
    ? {
        trailer: {
          '@type': 'VideoObject',
          name: `Tràiler de ${film.title}`,
          embedUrl: `https://www.youtube.com/embed/${film._trailerKey}`,
        },
      }
    : {}),
};
const jsonLdStr = JSON.stringify(jsonLd).replace(/<\/script>/gi, '<\\/script>');

// JSON-LD BreadcrumbList schema
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inici',
      item: siteUrl + '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: film.title,
      item: canonicalUrl,
    },
  ],
};
const breadcrumbLdStr = JSON.stringify(breadcrumbLd).replace(/<\/script>/gi, '<\\/script>');

// Color fallback for placeholder
const colorRe = /^#[0-9a-fA-F]{3,6}$/;
const c1 = colorRe.test(film.color1) ? film.color1 : '#111';
const c2 = colorRe.test(film.color2) ? film.color2 : '#222';

// Abbreviation for poster placeholder
const abbr = film.title
  .split(' ')
  .filter((w) => w.length > 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase()
  .slice(0, 3);

// Maps URL helper
function mapsUrl(cinema: string, city: string) {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${cinema}, ${city}`)}`;
}

// Cache
Astro.response.headers.set('Cache-Control', 's-maxage=604800, stale-while-revalidate=86400');
---

<Base
  title={`${film.title} — FILMCAT`}
  description={description}
  ogImage={posterUrl}
  canonical={canonicalUrl}
  twitterCreator="@filmcatapp"
>
  <Header />

  <main id="main-content">
    <div class="film-page">
      <!-- ── HERO ── -->
      <div class="film-hero">
        {
          backdropUrl ? (
            <img
              class="film-backdrop-img"
              src={backdropUrl}
              alt=""
              aria-hidden="true"
              decoding="async"
            />
          ) : (
            <div
              class="film-backdrop-img"
              style={`background:linear-gradient(135deg,${c1},${c2})`}
              aria-hidden="true"
            />
          )
        }
        <div class="film-backdrop-gradient" aria-hidden="true"></div>
        <div class="film-hero-content">
          <a href="/" class="film-back-link" id="backLink" aria-label="Tornar a la cartellera">
            ← Cartellera
          </a>
          <div class="film-hero-main">
            <div class="film-poster">
              {
                posterUrl ? (
                  <img
                    src={posterUrl}
                    alt={`Pòster oficial de ${film.title}`}
                    width="120"
                    height="180"
                    decoding="async"
                    loading="eager"
                  />
                ) : (
                  <div
                    class="poster-placeholder"
                    style={`background:linear-gradient(160deg,${c1} 0%,${c2} 100%)`}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 100 88" width="32" style="opacity:.25">
                      <polygon points="50,0 100,88 0,88" fill="white" />
                    </svg>
                    <div class="abbr" style="font-size:1rem">
                      {abbr}
                    </div>
                  </div>
                )
              }
            </div>
            <div class="film-hero-info">
              <h1 class="film-title">{film.title}</h1>
              {
                film.titleOriginal && film.titleOriginal !== film.title && (
                  <p class="film-original-title">{film.titleOriginal}</p>
                )
              }
              <div class="film-tags">
                <span class={`badge${isVO ? ' vo' : ''}`}>
                  <abbr title={versionLabel[film.version] ?? film.version}>{film.version}</abbr>
                </span>
                {
                  ri && (
                    <span class={`badge rating${ri.level !== 'low' ? ` ${ri.level}` : ''}`}>
                      <abbr title={ri.full}>{ri.short}</abbr>
                    </span>
                  )
                }
                {cleanLanguage && <span class="tag">{cleanLanguage}</span>}
                {film.genres?.[0] && <span class="tag">{film.genres[0]}</span>}
                {
                  film.runtime && (
                    <span class="tag" aria-label={`Durada: ${film.runtime} minuts`}>
                      {film.runtime} min
                    </span>
                  )
                }
                {film.year && <span class="tag">{film.year}</span>}
                {film.director && <span class="tag">{film.director}</span>}
              </div>
              {
                premiereDisplay && (
                  <p class="film-premiere" aria-label={`Data d'estrena: ${premiereDisplay}`}>
                    <span aria-hidden="true">📅</span> Estrena: {premiereDisplay}
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </div>

      <!-- ── BODY ── -->
      <div class="film-body">
        <!-- Trailer -->
        {
          film._trailerKey && (
            <div>
              <a
                href={`https://www.youtube.com/watch?v=${film._trailerKey}`}
                target="_blank"
                rel="noopener noreferrer"
                class="trailer-btn"
                aria-label={`Veure el tràiler de ${film.title} a YouTube`}
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z" />
                </svg>
                Veure tràiler
              </a>
            </div>
          )
        }

        <!-- Synopsis -->
        {
          film.synopsis && (
            <div>
              <h2 class="film-section-title">Sinopsi</h2>
              <p class="film-synopsis">{film.synopsis}</p>
            </div>
          )
        }

        <!-- Version info -->
        {
          versionLabel[film.version] && (
            <div>
              <h2 class="film-section-title">Versió</h2>
              <p class="film-synopsis">{versionLabel[film.version]}</p>
            </div>
          )
        }

        <!-- Sessions -->
        <div>
          <h2 class="film-section-title">
            {
              film.sessions.length > 0
                ? `Sessions disponibles — ${sessionCount} horaris`
                : 'Sessions'
            }
          </h2>

          {
            film.sessions.length === 0 ? (
              <p class="status-msg">Properament — Sessions pendent de confirmar</p>
            ) : (
              <div class="sessions-grid" role="list" aria-label="Sessions disponibles">
                {film.sessions.map((session) => {
                  const isSessionVO = ['VO', 'VOSC', 'VOSE'].includes(session.lang);
                  return (
                    <div
                      class="session-cinema"
                      role="listitem"
                      data-province={cityToProvince(session.city)}
                      data-cinema={session.cinema}
                    >
                      <div class="session-cinema-header">
                        <div>
                          <div class="session-cinema-name-row">
                            <a
                              href={`/cinemes/${cinemaSlug(session.cinema)}`}
                              class="session-cinema-name session-cinema-name-link"
                              aria-label={`Veure el cinema ${session.cinema}`}
                            >
                              {session.cinema}
                            </a>
                          </div>
                          <div class="session-cinema-city">
                            <svg
                              width="12"
                              height="12"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              aria-hidden="true"
                            >
                              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                              <circle cx="12" cy="10" r="3" />
                            </svg>
                            {session.city}
                            <span aria-hidden="true" class="session-city-sep">
                              ·
                            </span>
                            <a
                              href={mapsUrl(session.cinema, session.city)}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="session-maps-link"
                              aria-label={`Com arribar a ${session.cinema}`}
                            >
                              Com arribar
                            </a>
                          </div>
                        </div>
                        <span class={`badge${isSessionVO ? ' vo' : ''}`}>
                          <abbr title={versionLabel[session.lang] ?? session.lang}>
                            {session.lang}
                          </abbr>
                        </span>
                      </div>
                      <div
                        class="session-times"
                        role="group"
                        aria-label={`Dies de projecció a ${session.cinema}`}
                      >
                        {session.times.map((time) => (
                          <span class="session-time" aria-label={`${time} a ${session.cinema}`}>
                            {time}
                            <span class="session-time-lang" aria-hidden="true">
                              {session.lang}
                            </span>
                          </span>
                        ))}
                      </div>
                      <div
                        class="session-horaris"
                        aria-live="polite"
                        aria-label={`Horaris d'avui a ${session.cinema}`}
                      />
                    </div>
                  );
                })}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>

  <Footer
    filmCount={totalFilmCount}
    cinemaCount={totalCinemaCount}
    sessionCount={totalSessionCount}
  />

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={jsonLdStr} />
  <script type="application/ld+json" set:html={breadcrumbLdStr} />

  <!-- Horaris en temps real: fetch /api/horaris per a cada cinema de la pàgina -->
  <script define:vars={{ filmTitle: film.title }}>
    document.addEventListener('astro:page-load', async () => {
      const cards = [...document.querySelectorAll('.session-cinema[data-cinema]')];
      if (cards.length === 0) return;

      // Mostra skeleton mentre carrega
      cards.forEach((card) => {
        const container = card.querySelector('.session-horaris');
        if (container)
          container.innerHTML = '<span class="horaris-loading" aria-hidden="true"></span>';
      });

      const today = new Date().toISOString().split('T')[0];
      const cinemaNames = [...new Set(cards.map((el) => el.dataset.cinema))];

      const params = new URLSearchParams({ film: filmTitle, data: today });
      cinemaNames.forEach((name) => params.append('c', name));

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 7000);

      try {
        const res = await fetch(`https://filmcat-api.vercel.app/api/horaris?${params}`, {
          signal: controller.signal,
        });
        clearTimeout(timer);
        if (!res.ok) throw new Error('API error');
        const { cinemes } = await res.json();

        for (const result of cinemes) {
          // Actualitza TOTES les cards del mateix cinema (pot repetir-se si el film té múltiples sessions)
          const matchingCards = cards.filter((el) => el.dataset.cinema === result.cinema);

          for (const card of matchingCards) {
            const container = card.querySelector('.session-horaris');
            if (!container) continue;

            if (result.status === 'ok' && result.sessions.length > 0) {
              const times = result.sessions
                .map((s) => {
                  const ver = s.version ? `<span class="horari-ver">${s.version}</span>` : '';
                  return `<span class="horari-time">${s.time}${ver}</span>`;
                })
                .join('');
              container.innerHTML = `<div class="horaris-row">${times}</div>`;
            } else if (result.web) {
              container.innerHTML =
                `<a href="${result.web}" target="_blank" rel="noopener noreferrer" class="horaris-web-link">` +
                `Consulta els horaris a la seva web <span aria-hidden="true">↗</span></a>`;
            } else {
              container.innerHTML = '';
            }
          }
        }
      } catch {
        clearTimeout(timer);
        // Fallback silenciós: elimina els skeletons
        cards.forEach((card) => {
          const container = card.querySelector('.session-horaris');
          if (container) container.innerHTML = '';
        });
      }
    });
  </script>

  <!-- Province-aware session grouping: reorders sessions when a province filter is active -->
  <script>
    document.addEventListener('astro:page-load', () => {
      const savedProvince = sessionStorage.getItem('filmcat_province');
      if (!savedProvince || savedProvince === 'all') return;

      const grid = document.querySelector('.sessions-grid');
      if (!grid) return;

      const items = [...grid.querySelectorAll(':scope > .session-cinema')];
      const inProvince = items.filter((el) => el.dataset.province === savedProvince);
      const others = items.filter((el) => el.dataset.province !== savedProvince);

      if (inProvince.length === 0) return;

      // Rebuild with labelled groups
      grid.innerHTML = '';
      grid.removeAttribute('role');
      grid.removeAttribute('aria-label');

      const makeLabel = (text, mod) => {
        const el = document.createElement('div');
        el.className = 'session-group-label' + (mod ? ' session-group-label--' + mod : '');
        el.textContent = text;
        return el;
      };
      const makeList = (label) => {
        const el = document.createElement('div');
        el.className = 'sessions-group';
        el.setAttribute('role', 'list');
        el.setAttribute('aria-label', label);
        return el;
      };

      const provList = makeList(`Sessions a ${savedProvince}`);
      inProvince.forEach((el) => provList.appendChild(el));
      grid.appendChild(makeLabel(savedProvince));
      grid.appendChild(provList);

      if (others.length > 0) {
        const othList = makeList('Altres sessions');
        others.forEach((el) => othList.appendChild(el));
        grid.appendChild(makeLabel('Altres sessions', 'others'));
        grid.appendChild(othList);
      }
    });
  </script>
</Base>
