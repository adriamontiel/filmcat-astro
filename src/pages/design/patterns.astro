---
export const prerender = true;
import DesignSystem from '../../layouts/DesignSystem.astro';
---

<DesignSystem title="Patrons" section="patterns">
  <h1 class="ds-page-title">Patrons</h1>
  <p class="ds-page-desc">
    Composicions de components que resolen casos d'ús recurrents de Filmcat. Els patrons no
    s'inventen per a cada pàgina — es reutilitzen de forma consistent.
  </p>

  <!-- SESSIONS PER DIA -->
  <div id="sessions" class="ds-section">
    <p class="ds-section-title">Sessions per cinema</p>

    <p class="patt-desc">
      La card de sessió mostra un cinema amb tots els seus dies i horaris. La jerarquia visual
      s'estableix per pes tipogràfic i opacitat, no per color.
    </p>

    <div
      class="ds-canvas dark"
      style="flex-direction: column; gap: 0; padding: 0; overflow: hidden; border-radius: 12px;"
    >
      <div class="session-cinema-demo">
        <div class="session-header">
          <div class="session-name-row">
            <span class="session-name">Cinemes Sant Cugat</span>
            <span class="badge">VDC</span>
            <span class="badge rating">TP</span>
          </div>
          <div class="session-city">Sant Cugat del Vallès</div>
        </div>
        <div class="session-days">
          <!-- Avui -->
          <div class="session-day today">
            <div class="session-day-label">Avui, Divendres 11 d'abril</div>
            <div class="horaris-row-demo">
              <span class="horari-time">16:00</span>
              <span class="horari-time">18:30</span>
              <span class="horari-time">20:15</span>
              <span class="horari-time">22:45</span>
            </div>
          </div>
          <!-- Demà -->
          <div class="session-day">
            <div class="session-day-label">Dissabte, 12 d'abril</div>
            <div class="horaris-row-demo">
              <span class="horari-time">15:30</span>
              <span class="horari-time">18:00</span>
              <span class="horari-time">20:30</span>
            </div>
          </div>
          <!-- Diumenge -->
          <div class="session-day">
            <div class="session-day-label">Diumenge, 13 d'abril</div>
            <div class="horaris-row-demo">
              <span class="horari-time">17:00</span>
              <span class="horari-time">19:45</span>
            </div>
          </div>
        </div>
        <div class="session-actions-demo">
          <a class="trailer-btn session-action-btn" href="#">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle
                cx="12"
                cy="10"
                r="3"></circle>
            </svg>
            Com arribar
          </a>
          <a class="trailer-btn session-action-btn" href="#">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline
                points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Web oficial
          </a>
        </div>
      </div>
    </div>

    <div class="anatomy">
      <p class="anatomy-title">Anatomia del patró</p>
      <div class="anatomy-items">
        <div class="anatomy-item">
          <span class="anatomy-num">1</span>
          <span class="anatomy-text"
            ><strong>Capçalera:</strong> nom del cinema + badges de versió i rating</span
          >
        </div>
        <div class="anatomy-item">
          <span class="anatomy-num">2</span>
          <span class="anatomy-text"
            ><strong>Etiqueta de dia:</strong> "Avui" en negreta (opacitat 1), els altres dies en text
            atenuat (opacitat 0.5)</span
          >
        </div>
        <div class="anatomy-item">
          <span class="anatomy-num">3</span>
          <span class="anatomy-text"
            ><strong>Pills d'horari:</strong> grid fluid amb <code>.horari-time</code></span
          >
        </div>
        <div class="anatomy-item">
          <span class="anatomy-num">4</span>
          <span class="anatomy-text"
            ><strong>Accions:</strong> separades per border-top, botons compactes (<code
              >.session-action-btn</code
            >)</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="ds-divider"></div>

  <!-- HERO STATS -->
  <div id="hero-stats" class="ds-section">
    <p class="ds-section-title">Hero Stats</p>

    <p class="patt-desc">
      Bloc estadístic del hero de portada. Tres mètriques clau separades per divisors verticals, amb
      números en Bebas Neue per a màxim impacte visual.
    </p>

    <div class="ds-canvas dark padded-v" style="justify-content: center;">
      <div class="hero-stats-demo">
        <div class="hs-stat">
          <div class="hs-num">42</div>
          <div class="hs-label">Pel·lícules</div>
        </div>
        <div class="hs-sep">·</div>
        <div class="hs-stat">
          <div class="hs-num">18</div>
          <div class="hs-label">Cinemes</div>
        </div>
        <div class="hs-sep">·</div>
        <div class="hs-stat">
          <div class="hs-num">384</div>
          <div class="hs-label">Sessions</div>
        </div>
      </div>
    </div>

    <div class="anatomy">
      <p class="anatomy-title">Anatomia del patró</p>
      <div class="anatomy-items">
        <div class="anatomy-item">
          <span class="anatomy-num">1</span>
          <span class="anatomy-text"
            ><strong>Número:</strong> Bebas Neue, mida gran. Impacte visual immediat.</span
          >
        </div>
        <div class="anatomy-item">
          <span class="anatomy-num">2</span>
          <span class="anatomy-text"
            ><strong>Label:</strong> Outfit, text atenuat (<code>--muted</code>), mida petita.</span
          >
        </div>
        <div class="anatomy-item">
          <span class="anatomy-num">3</span>
          <span class="anatomy-text"
            ><strong>Separador:</strong> punt centrat (<code>·</code>) en color border per no
            competir amb els valors.</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="ds-divider"></div>

  <!-- BADGE COMBO -->
  <div class="ds-section">
    <p class="ds-section-title">Combinació de badges</p>

    <p class="patt-desc">
      Les películes sovint combinen múltiples badges. L'ordre recomanat: versió lingüística → rating
      → estrena.
    </p>

    <div class="ds-canvas" style="flex-direction: column; gap: 16px; align-items: flex-start;">
      <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
        <span class="badge">VDC</span>
        <span class="badge rating">TP</span>
      </div>
      <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
        <span class="badge">VO</span>
        <span class="badge vo">VOSC</span>
        <span class="badge rating mid">+12</span>
      </div>
      <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
        <span class="badge">VDC</span>
        <span class="badge rating high">+16</span>
        <span class="tag tag-premiere">Estrena</span>
      </div>
    </div>
  </div>
</DesignSystem>

<style>
  .patt-desc {
    font-size: 0.85rem;
    color: var(--text-mid);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  /* SESSION DEMO */
  .session-cinema-demo {
    padding: 20px;
    width: 100%;
  }
  .session-header {
    margin-bottom: 20px;
  }
  .session-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }
  .session-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }
  .session-city {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .session-days {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }
  .session-day {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .session-day-label {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--text);
    opacity: 0.5;
  }
  .session-day.today .session-day-label {
    font-weight: 700;
    opacity: 1;
  }
  .horaris-row-demo {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .session-actions-demo {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  /* HERO STATS DEMO */
  .hero-stats-demo {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .hs-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hs-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .hs-label {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .hs-sep {
    font-size: 2rem;
    color: var(--border);
    padding-bottom: 20px;
  }

  /* ANATOMY */
  .anatomy {
    margin-top: 20px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 20px;
  }
  .anatomy-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .anatomy-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .anatomy-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .anatomy-num {
    background: var(--surface2);
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .anatomy-text {
    font-size: 0.78rem;
    color: var(--text-mid);
    line-height: 1.5;
  }
  .anatomy-text strong {
    color: var(--text);
    font-weight: 600;
  }
  .anatomy-text code {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    color: var(--gold);
  }
</style>
