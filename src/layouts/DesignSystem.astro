---
import { rootCSS } from '../lib/design-tokens';
import '../styles/components.css';

interface Props {
  title?: string;
  section?: 'intro' | 'tokens' | 'components' | 'patterns';
}

const { title = 'Design System', section = 'intro' } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ca" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Filmcat Design System</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style set:html={rootCSS({ '--sidebar-w': '220px' })}></style>
    <style is:global>
      /* ── FONTS ── */
      @font-face {
        font-family: 'Bebas Neue';
        src: url('/fonts/bebas-neue-400-latin-ext.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Bebas Neue';
        src: url('/fonts/bebas-neue-400-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Outfit';
        src: url('/fonts/outfit-latin-ext.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Outfit';
        src: url('/fonts/outfit-latin.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Space Mono';
        src: url('/fonts/space-mono-400-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Space Mono';
        src: url('/fonts/space-mono-700-latin.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      /* ── RESET ── */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        background: var(--bg);
        color-scheme: dark;
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        line-height: 1.5;
        overflow-x: hidden;
        min-height: 100vh;
      }

      /* ── LAYOUT ── */
      .ds-app {
        display: grid;
        grid-template-columns: var(--sidebar-w) 1fr;
        grid-template-rows: auto 1fr;
        min-height: 100vh;
      }
      .ds-topbar {
        grid-column: 1 / -1;
        background: var(--bg2);
        border-bottom: 1px solid var(--border);
        height: 48px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        gap: 12px;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .ds-topbar-logo {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.1rem;
        letter-spacing: 0.06em;
        color: var(--text);
        text-decoration: none;
      }
      .ds-topbar-logo span {
        color: var(--red);
      }
      .ds-topbar-sep {
        color: var(--border);
        font-size: 1.2rem;
        opacity: 0.4;
      }
      .ds-topbar-title {
        font-size: 0.8rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
      .ds-topbar-badge {
        margin-left: auto;
        font-size: 0.7rem;
        font-family: 'Space Mono', monospace;
        color: var(--muted);
        background: var(--surface);
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid var(--border);
      }
      .ds-sidebar {
        background: var(--bg2);
        border-right: 1px solid var(--border);
        padding: 20px 0;
        position: sticky;
        top: 48px;
        height: calc(100vh - 48px);
        overflow-y: auto;
      }
      .ds-nav-section {
        margin-bottom: 6px;
      }
      .ds-nav-label {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--muted);
        padding: 10px 16px 4px;
        text-transform: uppercase;
      }
      .ds-nav-link {
        display: block;
        padding: 6px 16px;
        font-size: 0.82rem;
        color: var(--text-mid);
        text-decoration: none;
        transition:
          color 0.15s,
          background 0.15s;
        border-left: 2px solid transparent;
      }
      .ds-nav-link:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.04);
      }
      .ds-nav-link.active {
        color: var(--red-focus);
        border-left-color: var(--red);
        background: rgba(192, 57, 43, 0.08);
      }
      .ds-nav-link.sub {
        padding-left: 28px;
        font-size: 0.78rem;
      }
      .ds-nav-divider {
        height: 1px;
        background: var(--border);
        margin: 10px 16px;
      }
      .ds-main {
        padding: 40px 48px;
        max-width: 900px;
      }

      /* ── DESIGN SYSTEM PAGE COMPONENTS ── */
      .ds-page-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.4rem;
        letter-spacing: 0.04em;
        color: var(--text);
        margin-bottom: 8px;
      }
      .ds-page-desc {
        font-size: 0.95rem;
        color: var(--text-mid);
        max-width: 560px;
        margin-bottom: 40px;
        line-height: 1.6;
      }
      .ds-section {
        margin-bottom: 48px;
      }
      .ds-section-title {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
      }
      .ds-divider {
        height: 1px;
        background: var(--border);
        margin: 40px 0;
      }

      /* ── TOKEN SWATCHES ── */
      .ds-swatch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
      }
      .ds-swatch {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
      }
      .ds-swatch-color {
        height: 72px;
        width: 100%;
      }
      .ds-swatch-info {
        background: var(--surface);
        padding: 8px 10px;
      }
      .ds-swatch-name {
        font-family: 'Space Mono', monospace;
        font-size: 0.65rem;
        color: var(--gold);
        display: block;
        margin-bottom: 2px;
      }
      .ds-swatch-hex {
        font-family: 'Space Mono', monospace;
        font-size: 0.65rem;
        color: var(--muted);
      }
      .ds-swatch-desc {
        font-size: 0.68rem;
        color: var(--text-mid);
        margin-top: 3px;
      }

      /* ── TYPE SPECIMENS ── */
      .ds-type-row {
        display: flex;
        align-items: baseline;
        gap: 24px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .ds-type-meta {
        min-width: 130px;
        flex-shrink: 0;
      }
      .ds-type-meta-label {
        font-family: 'Space Mono', monospace;
        font-size: 0.62rem;
        color: var(--muted);
        display: block;
      }
      .ds-type-specimen {
        flex: 1;
      }

      /* ── COMPONENT CANVAS ── */
      .ds-canvas {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 28px;
        margin-bottom: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-start;
      }
      .ds-canvas.dark {
        background: var(--bg3);
      }
      .ds-canvas.padded-v {
        padding: 40px 28px;
      }
      .ds-code {
        background: var(--bg3);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 28px;
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-mid);
        overflow-x: auto;
        white-space: pre;
        line-height: 1.7;
      }
      .ds-component-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 10px;
        margin-top: 20px;
      }
      .ds-component-label:first-child {
        margin-top: 0;
      }

      /* ── SPACING VIZ ── */
      .ds-space-grid {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .ds-space-row {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .ds-space-bar {
        background: rgba(192, 57, 43, 0.3);
        border: 1px solid rgba(192, 57, 43, 0.5);
        border-radius: 4px;
        height: 24px;
        flex-shrink: 0;
      }
      .ds-space-meta {
        font-family: 'Space Mono', monospace;
        font-size: 0.65rem;
        color: var(--muted);
      }
      .ds-space-name {
        font-family: 'Space Mono', monospace;
        font-size: 0.65rem;
        color: var(--gold);
        min-width: 80px;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 768px) {
        .ds-app {
          grid-template-columns: 1fr;
        }
        .ds-sidebar {
          display: none;
        }
        .ds-main {
          padding: 24px 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="ds-app">
      <header class="ds-topbar">
        <a href="/design" class="ds-topbar-logo">FILM<span>CAT</span></a>
        <span class="ds-topbar-sep">/</span>
        <span class="ds-topbar-title">Design System</span>
        <span class="ds-topbar-badge">v1.0</span>
      </header>

      <nav class="ds-sidebar">
        <div class="ds-nav-section">
          <a href="/design" class={`ds-nav-link${path === '/design' ? ' active' : ''}`}
            >Introducció</a
          >
        </div>

        <div class="ds-nav-divider"></div>

        <div class="ds-nav-section">
          <div class="ds-nav-label">Tokens</div>
          <a
            href="/design/tokens"
            class={`ds-nav-link${path.startsWith('/design/tokens') ? ' active' : ''}`}
            >Visió general</a
          >
          <a href="/design/tokens#colors" class="ds-nav-link sub">Colors</a>
          <a href="/design/tokens#tipografia" class="ds-nav-link sub">Tipografia</a>
          <a href="/design/tokens#espaiat" class="ds-nav-link sub">Espaiat & Radis</a>
        </div>

        <div class="ds-nav-divider"></div>

        <div class="ds-nav-section">
          <div class="ds-nav-label">Components</div>
          <a
            href="/design/components"
            class={`ds-nav-link${path.startsWith('/design/components') ? ' active' : ''}`}
            >Visió general</a
          >
          <a href="/design/components#badges" class="ds-nav-link sub">Badges</a>
          <a href="/design/components#tags" class="ds-nav-link sub">Tags</a>
          <a href="/design/components#pills" class="ds-nav-link sub">Horari Pills</a>
          <a href="/design/components#botons" class="ds-nav-link sub">Botons</a>
          <a href="/design/components#feedback" class="ds-nav-link sub">Feedback</a>
          <a href="/design/components#filmcard" class="ds-nav-link sub">Film Card</a>
          <a href="/design/components#cinemacard" class="ds-nav-link sub">Cinema Card</a>
        </div>

        <div class="ds-nav-divider"></div>

        <div class="ds-nav-section">
          <div class="ds-nav-label">Patrons</div>
          <a
            href="/design/patterns"
            class={`ds-nav-link${path.startsWith('/design/patterns') ? ' active' : ''}`}
            >Visió general</a
          >
          <a href="/design/patterns#sessions" class="ds-nav-link sub">Sessions</a>
          <a href="/design/patterns#hero-stats" class="ds-nav-link sub">Hero Stats</a>
        </div>

        <div class="ds-nav-divider"></div>

        <div class="ds-nav-section">
          <a href="/" class="ds-nav-link">← Tornar a Filmcat</a>
        </div>
      </nav>

      <main class="ds-main">
        <slot />
      </main>
    </div>
  </body>
</html>
